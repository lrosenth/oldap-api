# Copy to .env.local and keep the populated file outside Git.
# Generate each JWT secret independently with: openssl rand -hex 32
OLDAP_REDIS_URL=redis://localhost:6379/0
OLDAP_STAGING_LOCK_REDIS_URL=redis://localhost:6379/1
OLDAP_ACCESS_JWT_SECRET=
OLDAP_REFRESH_JWT_SECRET=
OLDAP_MEDIA_JWT_SECRET=
OLDAP_PASSWORD_RESET_JWT_SECRET=
OLDAP_IMPORT_UPLOAD_JWT_SECRET=
OLDAP_IMPORT_SERVICE_JWT_SECRET=
OLDAP_EXPORT_SERVICE_JWT_SECRET=
OLDAP_EXPORT_DOWNLOAD_JWT_SECRET=
OLDAP_IMPORT_RECORDS_JWT_SECRET=
OLDAP_MEDIA_INGEST_URL=http://localhost:8088
OLDAP_MEDIA_INTERNAL_URL=http://localhost:8088
OLDAP_MEDIA_EXPORT_URL=http://localhost:8088
# Optional override; defaults to the package-bundled profile directory.
# OLDAP_EXPORT_PROFILE_DIR=/absolute/path/to/export-profiles
OLDAP_EXPORT_SERVICE_USER=
OLDAP_EXPORT_SERVICE_PASSWORD=
OLDAP_EXPORT_MAX_ARCHIVE_BYTES=50000000000
OLDAP_EXPORT_READY_RETENTION_HOURS=24
OLDAP_EXPORT_AUDIT_RETENTION_DAYS=60
OLDAP_EXPORT_MAX_ACTIVE_JOBS_PER_USER=3
OLDAP_EXPORT_MAX_ACTIVE_JOBS_TOTAL=20
OLDAP_EXPORT_MAX_RESERVED_BYTES_PER_USER=100000000000
OLDAP_EXPORT_MAX_RESERVED_BYTES_TOTAL=500000000000
OLDAP_IMPORT_SERVICE_USER=
OLDAP_IMPORT_SERVICE_PASSWORD=
OLDAP_IMPORT_EMAIL_BACKEND=console
OLDAP_EXPORT_EMAIL_BACKEND=console
OLDAP_PUBLIC_APP_URL=http://localhost:5173

OLDAP_AUTH_ADMIN_USER=
OLDAP_AUTH_ADMIN_PASSWORD=
OLDAP_PASSWORD_RESET_ADMIN_USER=
OLDAP_PASSWORD_RESET_ADMIN_PASSWORD=

OLDAP_AUTH_ALLOWED_ORIGINS=http://localhost:5173
OLDAP_REFRESH_COOKIE_SECURE=false
OLDAP_REFRESH_COOKIE_SAMESITE=Lax
OLDAP_PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
OLDAP_PASSWORD_RESET_EMAIL_BACKEND=console
